generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}


model Note {
  id        Int      @id @default(autoincrement())
  title     String
  subject   String
  semester  Int
  branch    String
  fileUrl   String
  createdAt DateTime @default(now())
}

model PYQ {
  id        Int      @id @default(autoincrement())
  title     String
  subject   String
  semester  Int
  branch    String
  fileUrl   String
  createdAt DateTime @default(now())
}

